// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatarUrl String?
  role      UserRole @default(Unassigned)
  jabatan   String?
  tasks     Task[]   @relation("TaskAssignees")
}

model Task {
  id            String       @id @default(cuid())
  title         Json
  description   Json
  status        TaskStatus
  assignees     User[]       @relation("TaskAssignees")
  dueDate       DateTime
  revisions     Json[]
  comments      Json[]
  files         Json[]
  subtasks      Json[]
  createdAt     DateTime     @default(now())
  category      TaskCategory
  valueCategory String
  value         Int
  evaluator     String
  approvedBy    String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  taskId    String?
  createdAt DateTime @default(now())
}

enum UserRole {
  roles_super_admin
  roles_admin
  roles_team_leader
  roles_team_member
  Social_Media_Officer
  Desain_Grafis
  Marketing
  Finance
  Unassigned
}

enum TaskCategory {
  Low
  Medium
  High
  Critical
}

enum TaskStatus {
  To_do
  In_Progress
  In_Review
  Completed
  Blocked
}
